# --- Claude API (콘텐츠 생성) ---
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- 네이버 검색광고 API (키워드 검색량/경쟁도) ---
# https://searchad.naver.com 광고주 가입 -> 도구 > API 사용 관리에서 발급
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=

# --- 네이버 오픈API (선택, 블로그 검색 결과수로 경쟁 문서량 확인) ---
# https://developers.naver.com/apps 애플리케이션 등록 -> 검색 API 사용 설정
NAVER_OPENAPI_CLIENT_ID=
NAVER_OPENAPI_CLIENT_SECRET=
